<!-- 로봇 모델만 RViz 로 보기 (슬라이더로 관절 움직이기) — 실습 1 'URDF 와 TF'
       roslaunch edu_pick_description display.launch -->
<launch>
  <param name="robot_description" command="$(find xacro)/xacro $(find edu_pick_description)/urdf/edu_pick.urdf.xacro"/>
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher"/>
  <node pkg="joint_state_publisher_gui" type="joint_state_publisher_gui" name="joint_state_publisher_gui"/>
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find edu_pick_description)/rviz/display.rviz"/>
</launch>
