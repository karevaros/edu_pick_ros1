Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 20
    - Class: rviz/RobotModel
      Name: RobotModel
      Enabled: true
      Robot Description: robot_description
    - Class: rviz/TF
      Name: TF
      Enabled: true
      Show Names: true
      Marker Scale: 0.15
      Frames:
        All Enabled: false
        tool_tip: {Value: true}
        d405_link: {Value: true}
        world: {Value: true}
        tcp: {Value: true}
  Global Options:
    Fixed Frame: world
    Background Color: 48; 48; 48
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 2.2
      Focal Point: {X: 0.35, Y: 0, Z: 0.1}
      Pitch: 0.45
      Yaw: 0.8
Window Geometry:
  Width: 1400
  Height: 900
