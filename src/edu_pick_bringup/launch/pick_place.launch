<!-- Pick and place 실습 — 전체 시스템 실행 (ROS 1 Noetic)

  ① 집에서 연습 (로봇·카메라 없이)
       roslaunch edu_pick_bringup pick_place.launch
  ② 실습실 — 로봇에 접속하되 제어박스 Simulation 모드 (팔은 안 움직임, 카메라는 실제)
       roslaunch edu_pick_bringup pick_place.launch mode:=real robot_ip:=192.168.35.100
  ③ 실습실 — 실제 구동 (강사 확인 후)
       roslaunch edu_pick_bringup pick_place.launch mode:=real robot_ip:=192.168.35.100 cb_simulation:=false

  그다음 다른 터미널에서 시나리오 노드를 단계 모드로 실행:  rosrun edu_pick_task pick_place.py 에 step 옵션 (README 3장)

  띄우는 노드
    robot_state_publisher   URDF → TF
    rb_driver               팔 (sim: 가상 하드웨어 / real: 레인보우 제어박스 TCP)
    gripper_adapter         RG2 (sim 에서는 명령을 보내지 않음)
    joint_state_publisher   팔 관절 + 그리퍼 관절을 합쳐 /joint_states
    move_group              MoveIt (계획·실행)
    카메라                  sim: fake_camera(가상) / real: realsense2_camera(D405)
    object_detector         물체 인식 (sim·real 같은 코드)
    rviz
-->
<launch>
  <arg name="mode" default="sim" doc="sim = 로봇 없이 연습 / real = 실기"/>
  <arg name="robot_ip" default="192.168.35.100" doc="제어박스 IP"/>
  <arg name="cb_simulation" default="true" doc="true = 제어박스 Simulation 모드(팔 안 움직임) / false = 🔴 실제 구동"/>
  <arg name="speed_bar" default="1.0" doc="접속할 때 거는 제어박스 속도바(0~1). 궤적 속도는 MoveIt 계획이 정한다"/>
  <arg name="max_joint_velocity" default="0.8" doc="이보다 빠른 관절이 있는 궤적은 드라이버가 실행하지 않는다 [rad/s]"/>
  <arg name="gripper_dry_run" default="auto" doc="auto = 실제 구동(cb_simulation:=false)일 때만 그리퍼 명령을 보냄 / true / false"/>
  <arg name="gripper_init" default="true" doc="false = 시작할 때 그리퍼 초기화·열기를 하지 않음 (물체를 쥔 채 다시 접속할 때)"/>
  <arg name="camera" default="true" doc="mode:=real 에서 D405 드라이버 실행 여부"/>
  <arg name="camera_serial" default="" doc="카메라가 여러 대일 때 시리얼"/>
  <arg name="rviz" default="true"/>

  <arg name="real" value="$(eval arg('mode') == 'real')"/>
  <arg name="grip_dry" value="$(eval (not arg('real') or arg('cb_simulation')) if arg('gripper_dry_run') == 'auto' else arg('gripper_dry_run') in (True, 'true', '1'))"/>

  <param name="robot_description" command="$(find xacro)/xacro $(find edu_pick_description)/urdf/edu_pick.urdf.xacro"/>
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher"/>

  <!-- 팔 -->
  <node pkg="edu_pick_driver" type="rb_driver.py" name="rb_driver" output="screen" required="true">
    <param name="fake" value="$(eval not arg('real'))"/>
    <param name="robot_ip" value="$(arg robot_ip)"/>
    <param name="cb_simulation" value="$(arg cb_simulation)"/>
    <param name="speed_bar" value="$(arg speed_bar)"/>
    <param name="max_joint_velocity" value="$(arg max_joint_velocity)"/>
  </node>

  <!-- 그리퍼 (Simulation 모드에서도 제어박스가 그리퍼 명령은 실행할 수 있어 기본은 '보내지 않음') -->
  <node pkg="edu_pick_bringup" type="gripper_adapter.py" name="gripper_adapter" ns="gripper_controller" output="screen">
    <param name="dry_run" value="$(arg grip_dry)"/>
    <param name="init_on_start" value="$(arg gripper_init)"/>
  </node>

  <node pkg="joint_state_publisher" type="joint_state_publisher" name="joint_state_publisher">
    <rosparam param="source_list">[arm/joint_states, gripper_controller/joint_states]</rosparam>
    <param name="rate" value="30"/>
  </node>

  <include file="$(find edu_pick_moveit)/launch/move_group.launch"/>

  <node pkg="edu_pick_perception" type="object_detector.py" name="object_detector" output="screen"/>

  <!-- 카메라 -->
  <node if="$(eval not arg('real'))" pkg="edu_pick_perception" type="fake_camera.py" name="fake_camera" output="screen"/>
  <include if="$(eval arg('real') and arg('camera'))" file="$(find realsense2_camera)/launch/rs_camera.launch">
    <arg name="camera" value="camera/d405"/>
    <arg name="tf_prefix" value="d405"/>
    <arg name="serial_no" value="$(arg camera_serial)"/>
    <arg name="filters" value="pointcloud"/>
    <arg name="ordered_pc" value="true"/>
    <arg name="align_depth" value="true"/>
  </include>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(find edu_pick_bringup)/rviz/pick_place.rviz"/>
</launch>
